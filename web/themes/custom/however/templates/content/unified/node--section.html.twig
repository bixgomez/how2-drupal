{#
  Section page for both journals. The two conditionals keep what the legacy
  templates did for each journal:
  - How(ever) sections showed the issue title as the volume and issue label,
    How2 sections "vol. n, no. n".
  - How2 sections did not pass their body to the component, so it was never
    shown.
#}
{% set is_however = node.field_journal_name.value == 'however' %}

{% include "@section/section.html.twig" with {
  journal: journal,
  journal_url: journal_url,
  title: label,
  title_display: content.field_title_display,
  subtitle: content.field_subtitle.0,
  volume_num: content.field_volume_reference['#items'].entity.field_volume_number.value,
  issue_num: content.field_issue_reference['#items'].entity.field_issue_number.value,
  volume_issue: is_however ? content.field_issue_reference[0]['#title'] : volume_issue,
  issue_pub_date: issue_pub_date,
  issue_url: issue_url,
  archive_url: content.field_archive_url,
  image_caption: content.field_image_caption,
  images: content.field_journal_page_images_media,
  body: is_however ? content.body : null,
  pieces: content.field_piece,
  working_notes: content.field_working_notes,
  person_bio: content.field_person_bio,
} %}
